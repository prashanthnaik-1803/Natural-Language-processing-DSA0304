lexicon = {"i": "PRP", "want": "VBP", "to": "TO", "the": "DT", "a": "DT",
           "dog": "NN", "book": "NN", "flight": "NN", "can": "MD"}

# (from_tag, to_tag, required previous tag)
rules = [
    ("NN", "VB", "TO"),
    ("VB", "NN", "DT"),
]

def initial_tag(words):
    return [lexicon.get(w.lower(), "NN") for w in words]

def apply_rules(words, tags):
    tags = tags[:]
    for frm, to, prev in rules:
        for i in range(1, len(tags)):
            if tags[i] == frm and tags[i - 1] == prev:
                print(f"  rule applied at '{words[i]}': {frm} -> {to} (prev tag = {prev})")
                tags[i] = to
    return tags

for sentence in ["I want to book a flight", "I want the book"]:
    words = sentence.split()
    base = initial_tag(words)
    print("\nSentence     :", sentence)
    print("Initial tags :", list(zip(words, base)))
    final = apply_rules(words, base)
    print("Final tags   :", list(zip(words, final)))
